@@ -12,3 +12,14 @@
 .alert {
   border-radius: 6px;
   padding: 0.5rem 0.75rem;
 }
+
+/* Draw the eye to a firing alert. */
+.alert--critical {
+  animation: alert-flash 0.18s steps(1) infinite;
+}
+
+@keyframes alert-flash {
+  50% { opacity: 0.1; }
+}
+
+.alert--critical .spinner { animation: spin 0.6s linear infinite; }
